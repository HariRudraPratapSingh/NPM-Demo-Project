# Application Server Port (type: number)
PORT=3000

# Primary Relational Database Connection (type: url)
DATABASE_URL=postgres://sentinel_admin:p@ssw0rd123@localhost:5432/sentinel_db

# Cryptographic JSON Web Token Secret (type: string)
JWT_SECRET=super_secret_production_ready_jwt_key_2026

# Platform Administrator Contact (type: email)
ADMIN_EMAIL=devops@sentinel-cloud.internal

# Operational Telemetry & Analytics Flag (type: boolean)
ENABLE_ANALYTICS=true

# Server Log Verbosity Level (info, debug, warn, error)
LOG_LEVEL=info
